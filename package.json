{
  "name": "sourcing-ontology-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint && pnpm run check:db-boundary && pnpm run check:contract",
    "check:db-boundary": "node scripts/check-db-boundary.mjs",
    "emit:contract": "turbo run build --filter=@sourcing/ontology && node scripts/emit-contract.mjs",
    "check:contract": "turbo run build --filter=@sourcing/ontology && node scripts/emit-contract.mjs --check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "conformance": "turbo run conformance",
    "demo": "turbo run demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
