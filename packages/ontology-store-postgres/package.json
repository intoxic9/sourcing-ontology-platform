{
  "name": "@sourcing/ontology-store-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "conformance": "tsx src/conformance.ts",
    "demo": "tsx src/demo.ts",
    "generate:week2": "pnpm --filter @sourcing/ontology build && tsx scripts/generate-week2-fixtures.ts",
    "ingest:week2": "tsx src/ingest/cli-week2-ingest.ts"
  },
  "dependencies": {
    "@sourcing/ontology": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
