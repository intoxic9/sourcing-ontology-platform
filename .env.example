# Copy to .env. Values match docker-compose.yml; they are development-only.
#
# Only @sourcing/ontology-store-postgres may read DATABASE_URL. This is enforced by
# `pnpm check:db-boundary`, not merely documented — see PLAN.md §6.3.
DATABASE_URL=postgres://sourcing:sourcing_dev_only@localhost:5432/sourcing_ontology

# apps/api
PORT=3000
